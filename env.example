# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Stripe Webhook Secret
# For local testing with Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook
# The CLI will provide a webhook secret starting with whsec_
# For production, get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend Configuration
# For local development with Vercel CLI, use /api (relative path works with proxy)
# For production, use /api (relative path)
VITE_STRIPE_API_URL=/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

